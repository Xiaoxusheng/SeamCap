# SeamCap 环境变量示例 —— 复制为项目根目录 .env 后修改
# 真实凭据严禁提交到 Git 仓库（.gitignore 已含 .env）

# 运行环境：development | production
APP_ENV=development

# HTTP 监听端口
PORT=8080

# 站对外可见的基础 URL（用于 canonical、sitemap、WhatsApp 询价文本中的产品链接）
BASE_URL=http://localhost:8080

# SQLite 数据库文件路径（持久化目录，纳入备份）
DB_PATH=./data/seamcap.db

# 上传文件目录（与代码分离，纳入备份）
UPLOAD_DIR=./uploads

# 备份输出目录
BACKUP_DIR=./data/backups

# 管理员会话有效期（小时）
SESSION_TTL_HOURS=168

# 首次启动时创建的初始管理员（首次登录后必须立即在后台修改密码）
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=

# ---- SMTP 邮件通知（部署前必须完成真实收发测试）----
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SeamCap Factory
NOTIFY_EMAIL=
# TLS 模式：ssl(465) | starttls(587) | none(仅内网调试)
SMTP_TLS=ssl

# 询价接口限流：每 IP 每小时最大提交次数
RATE_LIMIT_INQUIRY_PER_HOUR=10

# 上传限制（MB）
MAX_IMAGE_MB=10
MAX_VIDEO_MB=500
