{
	# 接入 Cloudflare 后：只在来源属于 CF 边缘节点时才采信 X-Forwarded-For / CF-Connecting-IP，
	# 否则访客可伪造头绕过限流。网段同 https://www.cloudflare.com/ips-v4、/ips-v6。
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

shirunhat.com, www.shirunhat.com {
  encode gzip zstd

  header {
    Strict-Transport-Security "max-age=31536000"
  }

  # handle_path 会剥掉前缀，再按各自 root 服务：/static/x -> web/static/x，/uploads/x -> uploads/x
  handle_path /static/* {
    root * /opt/seamcap/web/static
    file_server
    header Cache-Control "public, max-age=31536000, immutable"
  }

  handle_path /uploads/* {
    root * /opt/seamcap/uploads
    file_server
    header Cache-Control "public, max-age=31536000, immutable"
  }

  handle {
    reverse_proxy 127.0.0.1:8080
  }
}
