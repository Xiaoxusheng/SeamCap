# 容器版 Nginx 反代模板（由 nginx 镜像启动时 envsubst 渲染 ${DOMAIN}，取自 .env）
# www → 根域名 301；全站反代 app:8080；大文件上传放宽体积与超时
# 注意：$host、$remote_addr 等 nginx 内置变量不在容器环境里，envsubst 不会动它们

# 隐藏版本号；HSTS 仅按根域签发的证书范围生效，不盲目 includeSubDomains
server_tokens off;

# ---------- Cloudflare 真实客户端 IP 还原 ----------
# 仅当请求确实来自 Cloudflare 边缘节点时，才采信 CF-Connecting-IP；
# 未接入 Cloudflare 时本段无副作用（不会有 CF 网段来源的请求）。
# 作用：1) 让 $remote_addr 恢复为访客真实 IP，应用侧询盘限流（按 IP）才不会被全站合并计数；
#       2) access log 记录真实 IP 而非 CF 边缘 IP。
# 网段来自 https://www.cloudflare.com/ips-v4 与 /ips-v6，CF 调整网段时需同步更新。
set_real_ip_from 173.245.48.0/20;
set_real_ip_from 103.21.244.0/22;
set_real_ip_from 103.22.200.0/22;
set_real_ip_from 103.31.4.0/22;
set_real_ip_from 141.101.64.0/18;
set_real_ip_from 108.162.192.0/18;
set_real_ip_from 190.93.240.0/20;
set_real_ip_from 188.114.96.0/20;
set_real_ip_from 197.234.240.0/22;
set_real_ip_from 198.41.128.0/17;
set_real_ip_from 162.158.0.0/15;
set_real_ip_from 104.16.0.0/13;
set_real_ip_from 104.24.0.0/14;
set_real_ip_from 172.64.0.0/13;
set_real_ip_from 131.0.72.0/22;
set_real_ip_from 2400:cb00::/32;
set_real_ip_from 2606:4700::/32;
set_real_ip_from 2803:f800::/32;
set_real_ip_from 2405:b500::/32;
set_real_ip_from 2405:8100::/32;
set_real_ip_from 2a06:98c0::/29;
set_real_ip_from 2c0f:f248::/32;
real_ip_header CF-Connecting-IP;

# ---------- 80：Let's Encrypt 校验 + 其余 301 到 HTTPS ----------
server {
    listen 80;
    server_name ${DOMAIN} www.${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://${DOMAIN}$request_uri;
    }
}

# ---------- 443：www → 根域名 301（证书需同时含两个 SAN） ----------
server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    return 301 https://${DOMAIN}$request_uri;
}

# ---------- 443：主站 ----------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;

    # 大视频上传（应用上限 500MB）
    # 接入 Cloudflare 后：免费版请求体上限 100MB，需把 .env 的 MAX_VIDEO_MB 降到 90，
    # 否则 100MB 以上的视频会被 CF 直接拦截（413/520），源站看不到日志。详见 deploy/CLOUDFLARE.md
    client_max_body_size 520m;

    # 可选：只允许 Cloudflare 回源，彻底藏住源站 IP。
    # 推荐用 ufw / 云安全组按 CF 网段放行 80/443（挡在 TLS 之前，更彻底），步骤见 deploy/CLOUDFLARE.md

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://app:8080;
        # $http_host 透传原始 Host（含端口）：SameOrigin/CSRF 校验要求与 Origin 的 host:port 一致
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 对齐应用侧大上传超时（ReadTimeout 15min / WriteTimeout 16min）
        proxy_read_timeout 960s;
        proxy_send_timeout 960s;
    }
}
